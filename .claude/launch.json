{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "labdex-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "labdex-mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "labdex-web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve@14.2.4",
        "-s",
        "labdex-mobile/dist",
        "-l",
        "5050"
      ],
      "port": 5050
    }
  ]
}