{
  "expo": {
    "name": "LabDex",
    "slug": "labdex",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.labdex.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7C66",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.labdex.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "LabDex",
      "shortName": "LabDex",
      "themeColor": "#1B1A17",
      "backgroundColor": "#F4F1E8"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "LabDex uses the camera to scan the lab-number barcode on request forms.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "labdex",
    "backgroundColor": "#F3F4EF",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6f6ef1c-373e-4591-82db-d925b7665ca7"
      }
    },
    "owner": "chris_jnr"
  }
}
